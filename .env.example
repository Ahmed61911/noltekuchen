# =============================================================================
# Self-hosted stack environment variables.
# Copy this file to `.env` and fill in the values.
# Generate secrets with: openssl rand -hex 32
# =============================================================================

# ------- App --------------------------------------------------------------
NODE_ENV=development
APP_PORT=8080
APP_URL=http://localhost:8080
SESSION_SECRET=change-me-openssl-rand-hex-32

# ------- Supabase — public (browser-visible, injected at build time) ------
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_PROJECT_ID=self-hosted
VITE_SUPABASE_PUBLISHABLE_KEY=

# ------- Supabase — server-only -------------------------------------------
# In-network URL used by the Node SSR container to reach Kong.
SUPABASE_URL=http://kong:8000
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# 40+ char random string; used to sign the anon/service keys above.
SUPABASE_JWT_SECRET=

# ------- Postgres ---------------------------------------------------------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# ------- Auth (GoTrue) ----------------------------------------------------
GOTRUE_SITE_URL=${APP_URL}
GOTRUE_URI_ALLOW_LIST=${APP_URL}
GOTRUE_DISABLE_SIGNUP=true
GOTRUE_MAILER_AUTOCONFIRM=false
GOTRUE_JWT_EXP=3600

# ------- SMTP (placeholders — fill in for prod) ---------------------------
# Dev uses MailHog on smtp:1025 automatically.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_SENDER_NAME=Nolte Kuchen

# ------- Storage / MinIO --------------------------------------------------
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me-minio
STORAGE_S3_BUCKET=supabase-storage
STORAGE_S3_ENDPOINT=http://minio:9000
STORAGE_S3_REGION=us-east-1

# ------- Domains / TLS (prod only) ----------------------------------------
DOMAIN_APP=app.example.com
DOMAIN_SUPABASE=supabase.example.com
LETSENCRYPT_EMAIL=you@example.com

# ------- Lovable Cloud (one-time migration only) --------------------------
# Fill in temporarily to run scripts/export-lovable.sh, then unset.
LOVABLE_SUPABASE_URL=
LOVABLE_SUPABASE_SERVICE_ROLE_KEY=
