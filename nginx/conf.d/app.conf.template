# App + Supabase reverse proxy — TEMPLATE.
#
# This file is NOT read by nginx directly. Run `scripts/render-nginx.sh`
# (reads DOMAIN_APP / DOMAIN_SUPABASE from .env, runs envsubst) to generate
# the real `nginx/conf.d/app.conf` that nginx actually loads. Edit this
# template, not the generated app.conf — it gets overwritten every render.

# --- ACME HTTP-01 challenge (Let's Encrypt) -----------------------------
server {
  listen 80;
  server_name ${DOMAIN_APP} ${DOMAIN_SUPABASE};

  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }
  location / {
    return 301 https://$host$request_uri;
  }
}

# --- App --------------------------------------------------------------------
server {
  listen 443 ssl http2;
  server_name ${DOMAIN_APP};

  ssl_certificate     /etc/letsencrypt/live/${DOMAIN_APP}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_APP}/privkey.pem;
  ssl_protocols       TLSv1.2 TLSv1.3;

  # Repeats conf.d/security-headers.conf's headers rather than relying on
  # http-level inheritance: nginx's `add_header` REPLACES (doesn't merge
  # with) the parent context's list as soon as a server block defines its
  # own — and this block needs its own CSP (connect-src has to name the
  # Supabase domain, which the shared file can't know). Starting point, not
  # exhaustive — tighten further once you've inventoried every external
  # asset domain the app actually loads.
  add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
  add_header X-Frame-Options "SAMEORIGIN" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
  # Aucune source blob: n'est autorisée, volontairement. L'aperçu des
  # documents en avait besoin (il affichait le fichier via
  # URL.createObjectURL) et c'est ce que cette CSP bloquait ; l'aperçu a été
  # retiré, donc la permission l'est aussi. Le téléchargement n'est soumis à
  # aucune de ces directives et continue de fonctionner.
  #
  # Si un aperçu est réintroduit un jour, il faudra ajouter blob: à img-src,
  # connect-src, frame-src et worker-src — et vérifier que le rendu nginx est
  # bien régénéré, voir scripts/render-nginx.sh.
  add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://${DOMAIN_SUPABASE} wss://${DOMAIN_SUPABASE}; frame-ancestors 'self'; base-uri 'self'; form-action 'self'" always;

  # --- Ops UI (Grafana) -------------------------------------------------
  # Reached ONLY through here: the monitoring stack publishes no host ports,
  # so this vhost is the single way in. Two independent auth layers — nginx
  # basic auth, then Grafana's own login. The unguessable path is a
  # convenience, not a control; do not treat it as one.
  #
  # nginx matches the longest prefix location first, so this wins over
  # `location /` below regardless of ordering in the file.
  location /_ops/ {
    auth_basic "Nolte Ops";
    auth_basic_user_file /etc/nginx/conf.d/ops.htpasswd;

    # add_header REPLACES the server block's list as soon as a location
    # defines its own, so the inherited CSP is gone here — which is what we
    # want, since the app's CSP is far too strict for Grafana (it needs
    # unsafe-eval and blob: workers). Re-declare the headers that should
    # still apply, with a CSP scoped to Grafana's actual needs.
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; frame-ancestors 'self'" always;

    # Via a variable so nginx resolves at request time, not config load. This
    # also means a stopped Grafana degrades to a 502 on /_ops/ ONLY — with a
    # literal hostname, nginx would fail to start or reload at all whenever
    # the monitoring stack is down, taking the ERP with it.
    # Strip the gate's own credentials before they reach Grafana. Without
    # this, nginx forwards the `ops` basic-auth header upstream, Grafana
    # treats it as a login attempt for a Grafana user named `ops`, and every
    # request logs an authn failure — and in the UI it collides with
    # Grafana's own session login. The two auth layers must stay separate.
    proxy_set_header Authorization "";

    set $upstream_grafana grafana;
    proxy_pass http://$upstream_grafana:3000;
  }

  # --- Prometheus UI ----------------------------------------------------
  # Same gate as /_ops/. Useful mainly for the Targets page (spotting a
  # broken exporter at a glance) and raw PromQL; day-to-day querying is
  # nicer in Grafana Explore.
  #
  # NOTE: Prometheus has NO authentication of its own — unlike Grafana,
  # which has its own login behind the basic-auth gate. Here nginx basic
  # auth is the ONLY thing in front of it, and anyone through it can also
  # hit the admin-ish lifecycle endpoints (--web.enable-lifecycle exposes
  # POST /-/reload and /-/quit). Treat the ops password accordingly.
  location /_prom/ {
    auth_basic "Nolte Ops";
    auth_basic_user_file /etc/nginx/conf.d/ops.htpasswd;

    # As in /_ops/: a location-level add_header replaces the server's list,
    # and the app's CSP is too strict for the Prometheus UI.
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'self'" always;

    # Prometheus does not read Authorization; strip it so the gate's own
    # credentials are not forwarded needlessly.
    proxy_set_header Authorization "";

    set $upstream_prom prometheus;
    proxy_pass http://$upstream_prom:9090;
  }

  location / {
    # Variable indirection is load-bearing, not style — see the resolver
    # comment in nginx.conf. A literal `proxy_pass http://app:3000` caches
    # the IP for the worker's lifetime and silently serves whatever later
    # takes that address.
    set $upstream_app app;
    proxy_pass http://$upstream_app:3000;
  }
}

# --- Supabase API gateway (Kong) ---------------------------------------
server {
  listen 443 ssl http2;
  server_name ${DOMAIN_SUPABASE};

  ssl_certificate     /etc/letsencrypt/live/${DOMAIN_SUPABASE}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_SUPABASE}/privkey.pem;
  ssl_protocols       TLSv1.2 TLSv1.3;

  # No CSP here — this serves JSON, not HTML, so it's not meaningful. The
  # shared conf.d/security-headers.conf headers apply here via inheritance
  # since this block defines no add_header of its own.

  # Aggressive rate-limit on auth endpoints (login, signup, token refresh,
  # password recovery). Blocks brute-force without needing fail2ban.
  location ~ ^/auth/v1/(token|signup|recover|otp|verify|magiclink) {
    limit_req zone=auth_zone burst=10 nodelay;
    set $upstream_kong_auth kong;
    proxy_pass http://$upstream_kong_auth:8000;
  }

  # General API traffic (rest, storage, remaining auth reads).
  location / {
    limit_req zone=api_zone burst=60 nodelay;
    set $upstream_kong kong;
    proxy_pass http://$upstream_kong:8000;
  }
}
